# Copy to .env. Only the first block is required for local development.
# Every service below it is optional locally: with no key the app uses a clearly
# labelled stand-in (see lib/env.ts) and refuses to start that way in production.

# --- Required ---
DATABASE_URL="postgresql://nature:nature@localhost:5433/nature_food"
AUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Needed for Auth.js when the host is not Vercel (local, preview, tests).
AUTH_TRUST_HOST="true"
# Only when DATABASE_URL points at `prisma dev`, which has a single database session.
# DATABASE_POOL_MAX="1"

# --- Sign-in with Google ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe (cards, Apple Pay, Google Pay) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- PayPal ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# --- Real-time (Pusher). Without it, screens fall back to polling ---
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# --- Google Maps: checks delivery addresses against each branch's zone ---
GOOGLE_MAPS_API_KEY=""

# --- Email and SMS. Without them, messages are written to the server log ---
RESEND_API_KEY=""
EMAIL_FROM="Nature Food <orders@example.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
