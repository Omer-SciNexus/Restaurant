// Nature Food database schema. Launch tables only; Phase 2 tables (meal plans,
// loyalty, reviews, cooking classes) are added when those features are built.
//
// Conventions:
// - Money is stored as integer cents (USD), never floats.
// - Nutrition lives only on ingredients, per 100 g. Dish and bowl totals are calculated.
// - Diet tags are derived from ingredients (lib/diet.ts), so they are never stored on a dish.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  CUSTOMER
  STAFF
  DRIVER
  MANAGER
  ADMIN
}

/// The nine major US food allergens; each has an icon in public/images/icons/allergens.
enum Allergen {
  MILK
  EGGS
  FISH
  SHELLFISH
  TREE_NUTS
  PEANUTS
  WHEAT
  SOY
  SESAME
}

enum Diet {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
}

enum NutritionChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  /// Local development only. lib/payments refuses to use it in production.
  SIMULATED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentPurpose {
  ORDER
  RESERVATION_DEPOSIT
  EVENT_DEPOSIT
}

enum DeliveryMethod {
  OWN
  THIRD_PARTY
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum ReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum EventRequestType {
  PRIVATE_EVENT
  CATERING
}

enum EventRequestStatus {
  NEW
  QUOTED
  DEPOSIT_PAID
  DECLINED
  CLOSED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ---------------------------------------------------------------- branches and people

model Branch {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  address              String
  city                 String
  lat                  Float
  lng                  Float
  phone                String
  timezone             String   @default("America/Chicago")
  /// { mon: [{ open: "07:00", close: "21:00" }], ... }. An empty list means closed that day.
  openingHours         Json
  deliveryRadiusKm     Float    @default(2)
  /// Optional polygon, [[lat, lng], ...]. When set it replaces the radius.
  deliveryPolygon      Json?
  deliveryFeeCents     Int      @default(0)
  minOrderCents        Int      @default(0)
  /// Sales tax in basis points (825 = 8.25%). Set per branch once the city is confirmed.
  taxRateBps           Int      @default(0)
  tableCapacityPerSlot Int      @default(20)
  /// Rollback switch from the go-live plan: off means "in-store only".
  onlineOrderingOpen   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users        User[]
  menuItems    BranchMenuItem[]
  orders       Order[]
  reservations Reservation[]
  waitlist     WaitlistEntry[]
  events       EventRequest[]

  @@map("branches")
}
