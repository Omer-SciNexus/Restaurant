// Nature Food database schema. Launch tables only; Phase 2 tables (meal plans,
// loyalty, reviews, cooking classes) are added when those features are built.
//
// Conventions:
// - Money is stored as integer cents (USD), never floats.
// - Nutrition lives only on ingredients, per 100 g. Dish and bowl totals are calculated.
// - Diet tags are derived from ingredients (lib/diet.ts), so they are never stored on a dish.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  CUSTOMER
  STAFF
  DRIVER
  MANAGER
  ADMIN
}

/// The nine major US food allergens; each has an icon in public/images/icons/allergens.
enum Allergen {
  MILK
  EGGS
  FISH
  SHELLFISH
  TREE_NUTS
  PEANUTS
  WHEAT
  SOY
  SESAME
}

enum Diet {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
}

enum NutritionChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  /// Local development only. lib/payments refuses to use it in production.
  SIMULATED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentPurpose {
  ORDER
  RESERVATION_DEPOSIT
  EVENT_DEPOSIT
}

enum DeliveryMethod {
  OWN
  THIRD_PARTY
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum ReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum EventRequestType {
  PRIVATE_EVENT
  CATERING
}

enum EventRequestStatus {
  NEW
  QUOTED
  DEPOSIT_PAID
  DECLINED
  CLOSED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ---------------------------------------------------------------- branches and people

model Branch {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  address              String
  city                 String
  lat                  Float
  lng                  Float
  phone                String
  timezone             String   @default("America/Chicago")
  /// { mon: [{ open: "07:00", close: "21:00" }], ... }. An empty list means closed that day.
  openingHours         Json
  deliveryRadiusKm     Float    @default(2)
  /// Optional polygon, [[lat, lng], ...]. When set it replaces the radius.
  deliveryPolygon      Json?
  deliveryFeeCents     Int      @default(0)
  minOrderCents        Int      @default(0)
  /// Sales tax in basis points (825 = 8.25%). Set per branch once the city is confirmed.
  taxRateBps           Int      @default(0)
  tableCapacityPerSlot Int      @default(20)
  /// Rollback switch from the go-live plan: off means "in-store only".
  onlineOrderingOpen   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users        User[]
  menuItems    BranchMenuItem[]
  orders       Order[]
  reservations Reservation[]
  waitlist     WaitlistEntry[]
  events       EventRequest[]

  @@map("branches")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  /// Set for staff, drivers and managers; null for customers and admins.
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  diets         Diet[]
  allergies     Allergen[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  addresses        Address[]
  orders           Order[]
  reservations     Reservation[]
  eventRequests    EventRequest[]
  cookbook         CookbookEntry[]
  deliveries       Delivery[]              @relation("DeliveryDriver")
  changesMade      NutritionChange[]       @relation("ChangeAuthor")
  changesReviewed  NutritionChange[]       @relation("ChangeApprover")
  ingredientsChecked Ingredient[]          @relation("IngredientVerifier")
  resetTokens      PasswordResetToken[]

  @@index([role, branchId])
  @@map("users")
}

// Auth.js adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the emailed token; the token itself is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Address {
  id     String  @id @default(cuid())
  userId String
  label  String
  street String
  city   String
  lat    Float
  lng    Float
  notes  String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------- ingredients and nutrition

model Supplier {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  region         String
  story          String
  photoUrl       String?
  /// Only list a certification once certificateUrl holds the proof.
  certifications String[]
  certificateUrl String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ingredients Ingredient[]

  @@map("suppliers")
}

model Ingredient {
  id             String     @id @default(cuid())
  key            String     @unique
  name           String
  supplierId     String?
  supplier       Supplier?  @relation(fields: [supplierId], references: [id])
  // All nutrition values are per 100 g. kcal in kcal, the rest in grams.
  kcal           Float
  protein        Float
  carbs          Float
  fat            Float
  fibre          Float
  sugar          Float
  salt           Float
  allergens      Allergen[]
  /// Cross-contact risk from the supplier or shared equipment; shown as "may contain".
  mayContain     Allergen[]
  isVegan        Boolean
  isVegetarian   Boolean
  isGlutenFree   Boolean
  /// Null until a nutritionist has checked this row. The app shows a notice while null.
  verifiedById   String?
  verifiedBy     User?      @relation("IngredientVerifier", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  changes       NutritionChange[]
  menuItems     MenuItemIngredient[]
  options       Option[]
  recipes       RecipeIngredient[]

  @@map("ingredients")
}

/// Every nutrition or allergen edit waits here until a second person approves it.
model NutritionChange {
  id           String                @id @default(cuid())
  ingredientId String
  ingredient   Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  oldValues    Json
  newValues    Json
  changedById  String
  changedBy    User                  @relation("ChangeAuthor", fields: [changedById], references: [id])
  approvedById String?
  approvedBy   User?                 @relation("ChangeApprover", fields: [approvedById], references: [id])
  status       NutritionChangeStatus @default(PENDING)
  note         String?
  createdAt    DateTime              @default(now())
  reviewedAt   DateTime?

  @@index([status, createdAt])
  @@map("nutrition_changes")
}

// ---------------------------------------------------------------- menu

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  /// "HH:mm" in branch time, for example breakfast 07:00 to 11:00.
  servedFrom  String?
  servedUntil String?

  items MenuItem[]

  @@index([sortOrder])
  @@map("categories")
}

model MenuItem {
  id            String    @id @default(cuid())
  slug          String    @unique
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  name          String
  description   String
  basePriceCents Int
  imageUrl      String
  isSeasonal    Boolean   @default(false)
  availableFrom DateTime?
  availableTo   DateTime?
  /// Off means hidden everywhere without deleting the dish or its order history.
  isActive      Boolean   @default(true)
  /// Marks the bowl builder item, which has its own page.
  isBuilder     Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ingredients MenuItemIngredient[]
  branches    BranchMenuItem[]
  optionGroups OptionGroup[]
  orderItems  OrderItem[]
  recipes     Recipe[]

  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

model MenuItemIngredient {
  menuItemId   String
  ingredientId String
  grams        Float
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([menuItemId, ingredientId])
  @@map("menu_item_ingredients")
}

/// Per-branch state of a dish. No row means available at the shared price.
model BranchMenuItem {
  branchId           String
  menuItemId         String
  isAvailable        Boolean  @default(true)
  priceOverrideCents Int?
  updatedAt          DateTime @updatedAt
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([branchId, menuItemId])
  @@map("branch_menu_items")
}

model OptionGroup {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean  @default(false)
  min        Int      @default(0)
  max        Int      @default(1)
  sortOrder  Int      @default(0)

  options Option[]

  @@index([menuItemId])
  @@map("option_groups")
}

model Option {
  id              String      @id @default(cuid())
  optionGroupId   String
  group           OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name            String
  extraPriceCents Int         @default(0)
  ingredientId    String
  ingredient      Ingredient  @relation(fields: [ingredientId], references: [id])
  grams           Float
  imageUrl        String?
  sortOrder       Int         @default(0)
  isActive        Boolean     @default(true)

  @@index([optionGroupId])
  @@map("options")
}

// ---------------------------------------------------------------- orders

model Order {
  id                 String      @id @default(uuid())
  /// Short human reference shown to guests and staff, for example "NF-4F7K2Q".
  reference          String      @unique
  branchId           String
  branch             Branch      @relation(fields: [branchId], references: [id])
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  type               OrderType
  status             OrderStatus @default(PENDING_PAYMENT)
  customerName       String
  customerEmail      String
  customerPhone      String
  deliveryStreet     String?
  deliveryCity       String?
  deliveryLat        Float?
  deliveryLng        Float?
  deliveryNotes      String?
  subtotalCents      Int
  deliveryFeeCents   Int
  taxCents           Int
  totalCents         Int
  scheduledFor       DateTime?
  rejectionReason    String?
  allergyNote        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
  delivery Delivery?
  events   OrderEvent[]

  @@index([branchId, status, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}
