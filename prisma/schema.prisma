// Nature Food database schema. Launch tables only; Phase 2 tables (meal plans,
// loyalty, reviews, cooking classes) are added when those features are built.
//
// Conventions:
// - Money is stored as integer cents (USD), never floats.
// - Nutrition lives only on ingredients, per 100 g. Dish and bowl totals are calculated.
// - Diet tags are derived from ingredients (lib/diet.ts), so they are never stored on a dish.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  CUSTOMER
  STAFF
  DRIVER
  MANAGER
  ADMIN
}

/// The nine major US food allergens; each has an icon in public/images/icons/allergens.
enum Allergen {
  MILK
  EGGS
  FISH
  SHELLFISH
  TREE_NUTS
  PEANUTS
  WHEAT
  SOY
  SESAME
}

enum Diet {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
}

enum NutritionChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  /// Local development only. lib/payments refuses to use it in production.
  SIMULATED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentPurpose {
  ORDER
  RESERVATION_DEPOSIT
  EVENT_DEPOSIT
}

enum DeliveryMethod {
  OWN
  THIRD_PARTY
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum ReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum EventRequestType {
  PRIVATE_EVENT
  CATERING
}

enum EventRequestStatus {
  NEW
  QUOTED
  DEPOSIT_PAID
  DECLINED
  CLOSED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
